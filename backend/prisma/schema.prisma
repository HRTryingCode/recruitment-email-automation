generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The only currently-supported `provider` value is `"GMAIL"`. Outlook/IMAP
/// adapters are stubbed in the codebase but not wired through ingestion,
/// drafts, or reconciliation — do not insert other values without also
/// implementing the corresponding service paths.
model Mailbox {
  id            String         @id @default(cuid())
  /// Mailbox backend. Only `"GMAIL"` is supported today; see model-level doc.
  provider      String         @default("GMAIL")
  emailAddress  String         @unique
  displayName   String?
  credentials   String         @default("{}")
  watchExpiry   DateTime?
  lastHistoryId String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  threads       EmailThread[]
  messages      EmailMessage[]
  candidates    Candidate[]
}

model Candidate {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  company   String?
  title     String?
  role      String?
  status    String        @default("PENDING")
  source    String?
  notes     String?
  mailboxId String?
  mailbox   Mailbox?      @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  repliedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  threads   EmailThread[]

  @@index([mailboxId])
  @@index([status])
}

model EmailThread {
  id               String         @id @default(cuid())
  candidateId      String?
  candidate        Candidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  mailboxId        String
  mailbox          Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  externalThreadId String
  subject          String
  lastMessageAt    DateTime       @default(now())
  createdAt        DateTime       @default(now())
  messages         EmailMessage[]
  drafts           EmailDraft[]

  @@unique([mailboxId, externalThreadId])
  @@index([mailboxId])
  @@index([candidateId])
  @@index([lastMessageAt])
}

model EmailMessage {
  id                String      @id @default(cuid())
  threadId          String
  thread            EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailboxId         String
  mailbox           Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  externalMessageId String      @unique
  fromAddress       String
  fromName          String?
  toAddresses       String      @default("[]")
  subject           String
  bodyText          String?
  bodyHtml          String?
  receivedAt        DateTime
  headers           String      @default("{}")
  createdAt         DateTime    @default(now())

  @@index([threadId])
  @@index([mailboxId])
  @@index([receivedAt])
}

model EmailDraft {
  id                 String      @id @default(cuid())
  threadId           String
  thread             EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  inReplyToMessageId String?
  referencesHeader   String?
  subject            String
  bodyText           String
  bodyHtml           String?
  classification     String
  confidence         Float
  status             String      @default("PENDING")
  sentAt             DateTime?
  externalDraftId    String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([threadId])
  @@index([status])
}

model SystemLog {
  id        String   @id @default(cuid())
  event     String
  details   String   @default("{}")
  level     String   @default("INFO")
  createdAt DateTime @default(now())
}
