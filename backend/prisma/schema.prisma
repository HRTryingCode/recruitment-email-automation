generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?
  name         String?
  /// RBAC role. `recruiter` is the default for new @archive.com sign-ins;
  /// `admin` unlocks bulk/destructive endpoints (see requireAdmin middleware).
  role         String   @default("recruiter")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ownedCandidates Candidate[]
  gemConnection   GemConnection?
  draftPresence   DraftPresence[]
  savedViews      SavedView[]
}

/// The only currently-supported `provider` value is `"GMAIL"`. Outlook/IMAP
/// adapters are stubbed in the codebase but not wired through ingestion,
/// drafts, or reconciliation — do not insert other values without also
/// implementing the corresponding service paths.
model Mailbox {
  id            String         @id @default(cuid())
  /// Mailbox backend. Only `"GMAIL"` is supported today; see model-level doc.
  provider      String         @default("GMAIL")
  emailAddress  String         @unique
  displayName   String?
  credentials   String         @default("{}")
  watchExpiry   DateTime?
  lastHistoryId String?
  isActive      Boolean        @default(true)
  /// OAuth grant health: "OK" | "NEEDS_REAUTH". Set to NEEDS_REAUTH when
  /// Google returns invalid_grant / 401 (token revoked or expired); crons
  /// skip such mailboxes until a human reconnects (handleCallback resets it).
  /// Distinct from isActive, which only means "not manually disconnected".
  authStatus    String         @default("OK")
  /// Sanitized message of the error that flipped authStatus (no tokens).
  lastAuthError String?
  lastAuthErrorAt DateTime?
  /// Start time of the last reconcile attempt (success or failure). The
  /// hourly reconcile processes mailboxes oldest-first by this column so a
  /// deadline-hit run never starves the same mailboxes twice in a row.
  lastReconciledAt DateTime?
  /// Lowercased Gmail sendAs addresses (users.settings.sendAs.list), incl.
  /// the primary. Messages from any of these count as outbound (audit M11)
  /// and these aliases count as monitored for sender coverage (audit H2).
  sendAsAddresses String[]     @default([])
  sendAsSyncedAt  DateTime?
  /// Hand-off draft rules for this inbox: 'ethan' or 'coordinator'. Null
  /// falls back to the address map in claude.service getHandoffType (M4).
  handoffProfile String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  threads       EmailThread[]
  messages      EmailMessage[]
  candidates    Candidate[]
}

/// `email` is stored lowercased (M12). A unique index on lower(email) is
/// added by backend/scripts/b7/01_lowercase_candidate_emails.sql once the existing
/// case-collision group is merged; Prisma can't express a functional index.
model Candidate {
  id        String        @id @default(cuid())
  name      String
  email     String        @unique
  company   String?
  title     String?
  role      String?
  status    String        @default("PENDING")
  source    String?
  notes     String?
  /// Mailbox of the latest classified message (moves between inboxes; see
  /// firstMailboxId for the original one).
  mailboxId String?
  mailbox   Mailbox?      @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  /// Time of the recruiter's latest reply after a candidate message. Kept for
  /// the stale-draft filter; reply state now comes from the two fields below.
  repliedAt DateTime?
  /// Latest message from the candidate. Awaiting reply = lastInboundAt >
  /// lastOutboundAt (H6).
  lastInboundAt  DateTime?
  /// Latest message from the recruiter mailbox on the candidate's threads.
  lastOutboundAt DateTime?
  /// Mailbox that first created this candidate; never changes (M12).
  firstMailboxId String?
  /// Recruiter who owns this candidate (M12). Not assigned automatically yet.
  ownerUserId    String?
  owner          User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  threads   EmailThread[]
  /// Lever status (F2), refreshed by the lever-sync cron. Read-only mirror:
  /// ACTIVE | ARCHIVED | HIRED | NOT_FOUND | ERROR (see lever.service.ts).
  leverState          String?
  /// Primary opportunity: latest-updated active one, else latest archived.
  leverOpportunityId  String?
  leverPostingTitle   String?
  leverStage          String?
  leverArchivedReason String?
  leverCheckedAt      DateTime?
  /// Short reason code when leverState is ERROR (never a raw response).
  leverError          String?
  /// LinkedIn profile URL, from Gem or typed in the Add to Lever dialog (F3).
  /// The only Gem-sourced field we keep; résumés are streamed to Lever.
  linkedinUrl         String?
  /// Gem enrichment cache (H5). Filled by the Add to Lever Gem prefill and
  /// the new-candidate background lookup; served while gemFetchedAt < 7 days.
  /// Never the résumé file or its presigned URL — only whether one exists.
  gemPersonId         String?
  gemTitle            String?
  gemCompany          String?
  gemLocation         String?
  gemResumeAvailable  Boolean?
  /// Last Gem lookup that returned FOUND or NOT_FOUND (gemPersonId null).
  gemFetchedAt        DateTime?

  @@index([mailboxId])
  @@index([status])
  @@index([ownerUserId])
  @@index([leverState])
}

model EmailThread {
  id               String         @id @default(cuid())
  candidateId      String?
  candidate        Candidate?     @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  mailboxId        String
  mailbox          Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  externalThreadId String
  subject          String
  lastMessageAt    DateTime       @default(now())
  createdAt        DateTime       @default(now())
  messages         EmailMessage[]
  drafts           EmailDraft[]

  @@unique([mailboxId, externalThreadId])
  @@index([mailboxId])
  @@index([candidateId])
  @@index([lastMessageAt])
}

model EmailMessage {
  id                String      @id @default(cuid())
  threadId          String
  thread            EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  mailboxId         String
  mailbox           Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  externalMessageId String      @unique
  fromAddress       String
  fromName          String?
  toAddresses       String      @default("[]")
  subject           String
  bodyText          String?
  bodyHtml          String?
  receivedAt        DateTime
  headers           String      @default("{}")
  /// Ingestion pipeline state: "STORED" (row written, classify/draft not yet
  /// finished) | "PROCESSED" | "SKIPPED" (stored for context only) | "FAILED".
  /// The sweep-stuck-messages cron retries inbound STORED/FAILED rows.
  /// Rows that predate this column default to PROCESSED.
  processingState   String      @default("PROCESSED")
  /// Classification attempts (initial + sweeper retries).
  attempts          Int         @default(0)
  createdAt         DateTime    @default(now())

  @@index([threadId])
  @@index([mailboxId])
  @@index([receivedAt])
  @@index([processingState, createdAt])
}

model EmailDraft {
  id                 String      @id @default(cuid())
  threadId           String
  thread             EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  inReplyToMessageId String?
  referencesHeader   String?
  subject            String
  bodyText           String
  bodyHtml           String?
  classification     String
  confidence         Float
  status             String      @default("PENDING")
  sentAt             DateTime?
  externalDraftId    String?
  /// Model id, prompt version and Messages API token usage that produced the
  /// body. Null for template fallbacks and pre-B7 rows (M14).
  model              String?
  promptVersion      String?
  usage              Json?
  /// CC this draft goes out with (F4). NULL = pre-F4 row: use the configured
  /// default (DRAFT_CC_EMAIL). '' = the recruiter chose "No CC".
  ccEmail            String?
  /// One-step send (U0). Set with status SCHEDULED; the send runs once this
  /// passes unless undone. See lib/draftStatus for the state machine.
  scheduledSendAt    DateTime?
  sentByUserId       String?
  /// Sanitized reason the last send failed (status FAILED). Never a body.
  sendError          String?
  /// Out of the inbox queue until this time (U0 snooze, ≤ 30 days).
  snoozedUntil       DateTime?
  /// Set when a snooze expires so the UI can show the draft as unread.
  returnedFromSnoozeAt DateTime?
  /// wrong_label | spam | already_handled | not_needed | other
  dismissReason      String?
  dismissNote        String?
  dismissedByUserId  String?
  /// The model's body as generated/regenerated; bodyText holds edits. NULL
  /// on pre-U0 rows means "unknown".
  aiBodyText         String?
  editedAt           DateTime?
  editedByUserId     String?
  /// Classifier's one-line reason (≤140) and an exact quote (≤200) from the
  /// candidate's latest message backing it.
  classificationReason String?
  evidenceQuote      String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  presence           DraftPresence[]

  @@index([threadId])
  @@index([status])
  @@index([status, scheduledSendAt])
  @@index([snoozedUntil])
  // Partial unique index "EmailDraft_threadId_live_key" on ("threadId") WHERE
  // status IN LIVE_DRAFT_STATUSES (lib/draftStatus) lives in raw SQL
  // (migrations 9_ingestion_reliability, 9g_inbox) — Prisma can't express
  // partial indexes. It makes a second live draft per thread a P2002.
}

/// Who has a draft open (U0). Rows older than PRESENCE_STALE_MS (45s) are
/// ignored; a fresh 'editing' row from another user locks send/dismiss/edit.
model DraftPresence {
  id          String     @id @default(cuid())
  draftId     String
  draft       EmailDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'viewing' | 'editing'
  mode        String
  heartbeatAt DateTime   @default(now())

  @@unique([draftId, userId])
  @@index([heartbeatAt])
}

/// Saved filter set (U0, for R3 Candidates and the inbox). userId NULL =
/// team-shared (admins edit those).
model SavedView {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// 'candidates' | 'inbox'
  scope     String
  filters   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scope, userId])
}

model SystemLog {
  id        String   @id @default(cuid())
  event     String
  details   String   @default("{}")
  level     String   @default("INFO")
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([createdAt])
}

/// Gmail message ids that could not be fetched. NOT_FOUND (404: deleted
/// message or a draft that was sent/discarded) and FAILED rows that hit the
/// attempt cap are skipped by reconcile for 48h instead of being refetched
/// every hour. Keyed per mailbox because Gmail ids are per-user.
model GmailFetchTombstone {
  id                String   @id @default(cuid())
  mailboxId         String
  externalMessageId String
  /// "NOT_FOUND" | "FAILED"
  reason            String
  attempts          Int      @default(1)
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([mailboxId, externalMessageId])
  @@index([updatedAt])
}

/// Persistent OAuth state for CSRF protection on the Gmail connect flow.
/// Lives here instead of an in-memory Map because Vercel function instances
/// don't share memory — a callback hitting a different instance from
/// auth-init would otherwise reject as "invalid state". Rows are written
/// when /api/mailboxes/gmail/auth issues a state, consumed (consumedAt set)
/// when /api/mailboxes/gmail/callback validates it, and reaped opportunistically
/// (rows older than the 10-minute TTL) on each insert. See lib/oauthState.ts.
model OAuthState {
  state      String    @id
  mailboxId  String?
  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  @@index([createdAt])
}

/// Addresses we expect recruiting mail to be sent from (e.g. Gem sequence
/// send-aliases). Diffed against connected mailboxes + their sendAs aliases
/// by coverage.service to flag unmonitored senders (audit H2).
/// `source` = "ADMIN" (maintained via /api/coverage) or "GEM" (future sync).
model ExpectedSender {
  id               String   @id @default(cuid())
  /// Always stored lowercased.
  emailAddress     String   @unique
  displayName      String?
  source           String   @default("ADMIN")
  /// Id in the upstream system (e.g. Gem user id) when source != ADMIN.
  externalId       String?
  /// Sends seen upstream in the last 30 days; null = unknown.
  expectedSends30d Int?
  notes            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Per-user Gem MCP OAuth grant (F3). Tokens live encrypted (lib/crypto) in
/// `tokens` as JSON {access_token, refresh_token, ...}; never logged.
/// `status`: "PENDING" (authorize started, no tokens yet) | "OK" |
/// "NEEDS_REAUTH" (refresh failed; the user must reconnect).
model GemConnection {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Encrypted JSON of the OAuth tokens; null while PENDING.
  tokens             String?
  /// Dynamic client registration result (client_id etc.). Public client, no secret.
  clientRegistration Json?
  /// Encrypted PKCE verifier for an in-flight authorize; cleared on callback.
  pendingVerifier    String?
  expiresAt          DateTime?
  status             String    @default("PENDING")
  /// Sanitized error from the last failed refresh/exchange (no tokens).
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// One row per accepted Lever webhook delivery (H2), keyed by the delivery's
/// dedupe key (Lever's `id` when sent, else `event:opportunityId:triggeredAt`)
/// so a redelivery doesn't refresh twice. A few hundred tiny rows a day at
/// most; not pruned yet.
model LeverWebhookEvent {
  id            String   @id
  event         String
  opportunityId String?
  triggeredAt   DateTime
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
