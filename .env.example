# ─────────────────────────────────────────────
# DEPLOYMENT
# ─────────────────────────────────────────────
# Deploys as a single Vercel project — frontend at `/`,
# API at `/api/*`. Same origin, no CORS needed in production.

# ─────────────────────────────────────────────
# LOCAL DEVELOPMENT
# ─────────────────────────────────────────────
# When running locally, use a local Postgres or
# set POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING
# to point at a Neon/Supabase branch.

# ─────────────────────────────────────────────
# DATABASE  (Vercel Postgres / Neon)
# ─────────────────────────────────────────────
# Vercel auto-populates these when you add a Postgres store.
# For local dev, copy the values from the Vercel dashboard.
#
# Connection pooling notes:
# - POSTGRES_PRISMA_URL is the *pooled* URL (port 6543, `?pgbouncer=true`).
#   Use this for the runtime app — every Vercel function instance shares the
#   pooler instead of opening direct connections to Postgres.
# - POSTGRES_URL_NON_POOLING is the *direct* URL (port 5432). Use this for
#   migrations only (`prisma migrate deploy` / `migrate dev`), which need a
#   real session for advisory locks and DDL — the pooler does not support
#   those reliably. Prisma uses it automatically via `directUrl` in
#   `schema.prisma`.
# - Typical sustained-load pool size for this app is ~10 connections per
#   Vercel function instance. Serverless cold-starts make precise tuning
#   fiddly — when in doubt, lean lower and let the pooler queue.
# - See Supabase Supavisor docs for pool-mode tradeoffs (transaction vs
#   session pooling) before changing the URL:
#   https://supabase.com/docs/guides/database/supavisor
POSTGRES_PRISMA_URL=postgresql://user:pass@host/db?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://user:pass@host/db

# ─────────────────────────────────────────────
# ANTHROPIC / CLAUDE
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# GMAIL OAUTH2
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
# Local:
GMAIL_REDIRECT_URI=http://localhost:3001/api/mailboxes/gmail/callback
# Production (add both to Google Cloud Console — single Vercel domain):
# GMAIL_REDIRECT_URI=https://your-app.vercel.app/api/mailboxes/gmail/callback
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-watch

# Optional: enable signed JWT verification on the Gmail Pub/Sub push handler.
# When set, /api/webhooks/gmail rejects any POST without a valid OIDC token
# whose `aud` claim matches this value. To enable end-to-end, also configure
# the Pub/Sub subscription in GCP with an "Authentication" service account
# and audience matching this URL.
# PUBSUB_AUDIENCE=https://recruiting-email-automation-api.vercel.app/api/webhooks/gmail
# The push subscription's service account. When set (with PUBSUB_AUDIENCE),
# the token's verified `email` claim must equal it. Set both.
# PUBSUB_SERVICE_ACCOUNT_EMAIL=gmail-push@<project>.iam.gserviceaccount.com

# Sign-in policy. Login always requires an @archive.com Google Workspace
# account (Google `hd` claim). ALLOWED_USERS optionally narrows that to a
# list; ADMIN_EMAILS are promoted to admin on sign-in (never demoted) and are
# always allowed. No defaults.
# ALLOWED_USERS=sofia@archive.com,andriy.korzhenevskyy@archive.com
# ADMIN_EMAILS=sofia@archive.com,andriy.korzhenevskyy@archive.com

# Orphan-body retention (DESTRUCTIVE). When set to an integer >= 7, the daily
# cron nulls bodies of messages on threads with no candidate older than this
# many days. First run purges the existing backlog — needs explicit approval.
# ORPHAN_BODY_RETENTION_DAYS=30

# ─────────────────────────────────────────────
# GOOGLE WORKSPACE SERVICE ACCOUNT
# ─────────────────────────────────────────────
# paste the full key JSON as one line — works both locally and on Vercel
GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}

# ─────────────────────────────────────────────
# MICROSOFT / OUTLOOK (optional)
# ─────────────────────────────────────────────
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
AZURE_TENANT_ID=...

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
# Used to encrypt Mailbox.credentials (Gmail/Workspace OAuth tokens) at rest.
ENCRYPTION_KEY=

# Shared secret for the Vercel Cron renewal endpoint.
# Generate with: openssl rand -base64 32
# Vercel Cron must send `Authorization: Bearer <CRON_SECRET>` when calling
# POST /api/internal/cron/renew-watches.
CRON_SECRET=

# ─────────────────────────────────────────────
# DRAFT CC
# ─────────────────────────────────────────────
# Email address to CC on every AI-drafted outbound message (defaults to sofia@archive.com)
# DRAFT_CC_EMAIL=sofia@archive.com

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=3001
# FRONTEND_URL is only used for local dev CORS (Vite at :5173 -> backend at :3001).
# In production, the frontend and API share the same Vercel origin, so CORS is
# not required. Safe to leave at the local value.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins permitted to make cross-origin requests
# against /api/*. If unset, defaults to the production API URL so a
# misconfigured deploy fails closed rather than echoing any origin. For local
# dev with a separate Vite dev server, include http://localhost:5173.
# ALLOWED_ORIGINS=https://recruiting-email-automation-api.vercel.app,http://localhost:5173

# ─────────────────────────────────────────────
# FRONTEND (optional)
# ─────────────────────────────────────────────
# In production the frontend fetches `/api/*` same-origin via the built-in
# fallback in `frontend/src/lib/api.ts`. VITE_API_URL is only needed if you
# want to override that — e.g. point a deploy preview at a different API host.
# VITE_API_URL=https://example.com/api
