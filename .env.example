# ─────────────────────────────────────────────
# DEPLOYMENT
# ─────────────────────────────────────────────
# Deploys as a single Vercel project — frontend at `/`,
# API at `/api/*`. Same origin, no CORS needed in production.

# ─────────────────────────────────────────────
# LOCAL DEVELOPMENT
# ─────────────────────────────────────────────
# When running locally, use a local Postgres or
# set POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING
# to point at a Neon/Supabase branch.

# ─────────────────────────────────────────────
# DATABASE  (Vercel Postgres / Neon)
# ─────────────────────────────────────────────
# Vercel auto-populates these when you add a Postgres store.
# For local dev, copy the values from the Vercel dashboard.
POSTGRES_PRISMA_URL=postgresql://user:pass@host/db?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://user:pass@host/db

# ─────────────────────────────────────────────
# ANTHROPIC / CLAUDE
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# GMAIL OAUTH2
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
# Local:
GMAIL_REDIRECT_URI=http://localhost:3001/api/mailboxes/gmail/callback
# Production (add both to Google Cloud Console — single Vercel domain):
# GMAIL_REDIRECT_URI=https://your-app.vercel.app/api/mailboxes/gmail/callback
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail-watch

# ─────────────────────────────────────────────
# GOOGLE WORKSPACE SERVICE ACCOUNT
# ─────────────────────────────────────────────
# paste the full key JSON as one line — works both locally and on Vercel
GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}

# ─────────────────────────────────────────────
# MICROSOFT / OUTLOOK (optional)
# ─────────────────────────────────────────────
AZURE_CLIENT_ID=...
AZURE_CLIENT_SECRET=...
AZURE_TENANT_ID=...

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
# Used to encrypt Mailbox.credentials (Gmail/Workspace OAuth tokens) at rest.
ENCRYPTION_KEY=

# Shared secret for the Vercel Cron renewal endpoint.
# Generate with: openssl rand -base64 32
# Vercel Cron must send `Authorization: Bearer <CRON_SECRET>` when calling
# POST /api/internal/cron/renew-watches.
CRON_SECRET=

# ─────────────────────────────────────────────
# DRAFT CC
# ─────────────────────────────────────────────
# Email address to CC on every AI-drafted outbound message (defaults to sofia@archive.com)
# DRAFT_CC_EMAIL=sofia@archive.com

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=3001
# FRONTEND_URL is only used for local dev CORS (Vite at :5173 -> backend at :3001).
# In production, the frontend and API share the same Vercel origin, so CORS is
# not required. Safe to leave at the local value.
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────
# FRONTEND (optional)
# ─────────────────────────────────────────────
# In production the frontend fetches `/api/*` same-origin via the built-in
# fallback in `frontend/src/lib/api.ts`. VITE_API_URL is only needed if you
# want to override that — e.g. point a deploy preview at a different API host.
# VITE_API_URL=https://example.com/api
