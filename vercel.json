{
  "buildCommand": "npm run vercel-build --workspace=backend && npm run build --workspace=frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/cron/renew-watches", "schedule": "0 */6 * * *" },
    { "path": "/api/internal/cron/reconcile", "schedule": "0 * * * *" }
  ]
}
