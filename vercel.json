{
  "buildCommand": "npm run build --workspace=frontend && npm run vercel-build --workspace=backend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-/rzFyukahTSdggRa544xLsIYHoDRTWK3Vqc4XhNHQes=' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://accounts.google.com/gsi/; frame-src 'self' https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/internal/cron/renew-watches", "schedule": "0 */6 * * *" },
    { "path": "/api/internal/cron/reconcile", "schedule": "0 * * * *" },
    { "path": "/api/internal/cron/watchdog", "schedule": "*/15 * * * *" },
    { "path": "/api/internal/cron/sweep-stuck-messages", "schedule": "5-59/10 * * * *" },
    { "path": "/api/internal/cron/systemlog-retention", "schedule": "30 3 * * *" },
    { "path": "/api/internal/cron/coverage-summary", "schedule": "0 14 * * 1" },
    { "path": "/api/internal/cron/purge-orphan-bodies", "schedule": "45 3 * * *" },
    { "path": "/api/internal/cron/lever-sync", "schedule": "20 */3 * * *" },
    { "path": "/api/internal/cron/lever-sync-new", "schedule": "7-59/15 * * * *" }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/email-automation-system-OEgcU": true
    }
  }
}
