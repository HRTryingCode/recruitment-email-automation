{
  "buildCommand": "npm run build --workspace=frontend && npm run vercel-build --workspace=backend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "includeFiles": "backend/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/internal/cron/renew-watches", "schedule": "0 */6 * * *" },
    { "path": "/api/internal/cron/reconcile", "schedule": "0 * * * *" },
    { "path": "/api/internal/cron/watchdog", "schedule": "*/15 * * * *" },
    { "path": "/api/internal/cron/sweep-stuck-messages", "schedule": "5-59/10 * * * *" },
    { "path": "/api/internal/cron/systemlog-retention", "schedule": "30 3 * * *" },
    { "path": "/api/internal/cron/coverage-summary", "schedule": "0 14 * * 1" }
  ],
  "git": {
    "deploymentEnabled": {
      "claude/email-automation-system-OEgcU": true
    }
  }
}
